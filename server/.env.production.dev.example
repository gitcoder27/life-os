NODE_ENV=production
HOST=127.0.0.1
PORT=3105
APP_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/life_os_prod_sandbox
DEV_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/life_os_dev
PROD_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/life_os
SESSION_COOKIE_NAME=life_os_session_dev_service
SESSION_SECRET=replace-with-a-strong-local-production-mode-secret
SESSION_TTL_DAYS=14
CSRF_COOKIE_NAME=life_os_csrf_dev_service
ENV_FILE_OVERRIDE=false
DATABASE_SEPARATION_STRICT=true
AUTO_APPLY_MIGRATIONS=false
AUTO_CREATE_DATABASE=false
TRUST_PROXY=false
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
ALLOW_PRODUCTION_BOOTSTRAP=false
# First deploy only: set ALLOW_PRODUCTION_BOOTSTRAP=true and use a strong non-example password.
# BOOTSTRAP_USER_EMAIL=owner@example.com
# BOOTSTRAP_USER_PASSWORD=Use-A-Unique-Prod#Password1
# BOOTSTRAP_USER_DISPLAY_NAME=Owner
